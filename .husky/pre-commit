#!/bin/bash
#
# Pre-commit hook for MuseumCheck
# Enforces quality standards for museum data changes
#
# This hook:
# 1. Checks if any museum data files were modified
# 2. Runs the museum verification tool on modified museums
# 3. Prevents commits with unverified or low-quality museums (strict mode)
# 4. Checks document location compliance

set -e

# ====== Run tests before commit ======
echo "🧪 Running tests before commit..."
if ! npm test --silent 2>/dev/null; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "❌ COMMIT BLOCKED: Tests failed"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "Run 'npm test' to see detailed failures."
    echo ""
    echo "Or bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi
echo "✅ All tests passed!"
echo ""

# ====== Run quick page verification ======
echo "🚀 Running quick page verification..."
if ! npm run verify:pages:simple --silent 2>/dev/null; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "❌ COMMIT BLOCKED: Page verification failed"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "Run 'npm run verify:pages:simple' to see detailed failures."
    echo ""
    echo "Or bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi
echo "✅ Page verification passed!"
echo ""

# ====== Run data quality checks ======
echo "📊 Running data quality checks..."
if ! npm run test:data-quality --silent 2>/dev/null; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "❌ COMMIT BLOCKED: Data quality checks failed"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "Run 'npm run test:data-quality' to see detailed failures."
    echo ""
    exit 1
fi
echo "✅ Data quality checks passed!"
echo ""

# ====== Check document location compliance ======
echo "📝 Checking document location compliance..."
STAGED_MD_FILES=$(git diff --cached --name-only | grep "\.md$" || true)

if [ -n "$STAGED_MD_FILES" ]; then
    echo "📋 Found staged MD files:"
    echo "$STAGED_MD_FILES" | while read -r file; do
        [ -n "$file" ] && echo "  - $file"
    done
    echo ""
    
    # Run the docs location check script
    if ! bash scripts/check-docs-location.sh; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "❌ COMMIT BLOCKED: Document location check failed"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "Please move MD files to appropriate directories:"
        echo "  - docs/architecture/ - Architecture docs"
        echo "  - docs/features/     - Feature docs"
        echo "  - docs/guides/       - Development guides"
        echo "  - docs/api/          - API docs"
        echo "  - docs/reports/      - Progress reports"
        echo ""
        echo "Or bypass this check (NOT RECOMMENDED):"
        echo "  git commit --no-verify"
        echo ""
        exit 1
    fi
    echo "✅ Document location compliance passed!"
    echo ""
    
    # ====== Check document consistency ======
    echo "� Checking document consistency..."
    if ! bash scripts/check-docs-consistency.sh; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "❌ COMMIT BLOCKED: Document consistency check failed"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "Fix the inconsistencies or run manually:"
        echo "  npm run verify:docs-consistency"
        echo "  npm run verify:docs-content"
        echo ""
        exit 1
    fi
    
    # ====== Check document content consistency ======
    echo "📖 Checking document content consistency..."
    if ! node scripts/check-docs-content-consistency.js; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "❌ COMMIT BLOCKED: Document content conflicts detected"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "Fix the content conflicts or run manually:"
        echo "  npm run verify:docs-content"
        echo ""
        exit 1
    fi
    echo "✅ Document consistency checks passed!"
    echo ""
else
    echo "📝 No MD files staged, skipping document checks."
    echo ""
fi

# ====== Check file placement compliance ======
echo "📁 Checking file placement compliance..."
STAGED_FILES=$(git diff --cached --name-only)

if [ -n "$STAGED_FILES" ]; then
    # Run the comprehensive file placement check script
    if ! bash scripts/check-file-placement.sh; then
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "❌ COMMIT BLOCKED: File placement check failed"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "Please move files to appropriate directories according to project structure."
        echo "See docs/DIRECTORY_STRUCTURE.md for detailed guidelines."
        echo ""
        echo "Or bypass this check (NOT RECOMMENDED):"
        echo "  git commit --no-verify"
        echo ""
        exit 1
    fi
    echo "✅ File placement compliance passed!"
    echo ""
else
    echo "📁 No files staged, skipping file placement check."
    echo ""
fi

# ====== Auto-sync museums-meta.json → museums-meta.js ======
META_JSON="data/museums-meta.json"
META_JS="js/museums-meta.js"
STAGED_META_JSON=$(git diff --cached --name-only | grep "$META_JSON" || true)

if [ -n "$STAGED_META_JSON" ]; then
    echo "🔄 museums-meta.json changed, regenerating museums-meta.js..."
    node tools/generate-museums-meta-js.js
    git add "$META_JS"
    echo "✅ museums-meta.js updated and staged"
    echo ""
fi

# ====== Museum verification ======
VERIFY_TOOL="node tools/verify-museum-official.js"
SCRIPT_FILE="script.js"
STAGED_SCRIPT=$(git diff --cached --name-only | grep "$SCRIPT_FILE" || true)

if [ -z "$STAGED_SCRIPT" ]; then
    exit 0
fi

echo "🔍 MuseumCheck Quality Gate: Verifying museum data..."

# Extract newly added/modified museums from the staged changes
ADDED_MUSEUMS=$(git diff --cached -- "$SCRIPT_FILE" | grep "^+.*name:" | sed 's/.*name:\s*['"'"'"]\([^'"'"'"]*\)['"'"'"].*/\1/' | sort | uniq)

if [ -z "$ADDED_MUSEUMS" ]; then
    exit 0
fi

echo "📋 Found modified museums:"
echo "$ADDED_MUSEUMS" | while read -r museum; do
    [ -n "$museum" ] && echo "  - $museum"
done

echo ""
echo "⏳ Running official verification (strict mode)..."
echo ""

VERIFY_FAILED=0
VERIFY_WARNED=0

echo "$ADDED_MUSEUMS" | while read -r museum; do
    if [ -z "$museum" ]; then
        continue
    fi
    
    # Run verification in strict mode
    OUTPUT=$($VERIFY_TOOL "$museum" --strict 2>&1 || true)
    EXIT_CODE=$?
    
    if [ $EXIT_CODE -eq 0 ]; then
        echo "✅ $museum - Verified"
    else
        echo "⚠️  $museum - NOT verified (strict mode)"
        VERIFY_FAILED=$((VERIFY_FAILED + 1))
    fi
done

if [ $VERIFY_FAILED -gt 0 ]; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "❌ COMMIT BLOCKED: Museum verification failed in strict mode"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "To fix this, verify your museums match the official database:"
    echo "  $VERIFY_TOOL \"Museum Name\" --strict --verbose"
    echo ""
    echo "Or bypass this check (NOT RECOMMENDED):"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo ""
echo "✅ All museums verified! Proceeding with commit..."
exit 0
