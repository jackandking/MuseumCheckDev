{
  "name": "museum-check",
  "version": "2.1.4",
  "description": "Museum Checklist Web Application - 博物馆打卡应用",
  "main": "script.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:data-quality": "jest tests/data-quality.test.js",
    "test:image-search": "node tools/test-image-search.js",
    "validate-data": "node tools/validate-museum-data.js",
    "serve": "python3 -m http.server 8000",
    "build:meta": "node tools/generate-museums-meta.js",
    "search:demo": "node tools/search-museum-images-demo.js",
    "export:kvstore": "node tools/export-kvstore-to-static.js --all",
    "export:kvstore:dry-run": "node tools/export-kvstore-to-static.js --all --dry-run",
    "export:kvstore:force": "node tools/export-kvstore-to-static.js --all --force",
    "mcp:start": "node museum-mcp-server.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
    ,"verify:everyone":"bash tools/verify_everyone_with_curl.sh"
  },
  "keywords": [
    "museum",
    "checklist",
    "education",
    "travel",
    "china"
  ],
  "author": "jackandking",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.56.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "qrcode": "^1.5.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "script.js",
      "!**/node_modules/**"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
