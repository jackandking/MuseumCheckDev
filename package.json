{
  "name": "museum-check",
  "version": "2.1.4",
  "description": "Museum Checklist Web Application - 博物馆打卡应用",
  "main": "script.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:data-quality": "jest tests/data-quality.test.js",
    "test:image-search": "node tools/test-image-search.js",
    "validate-data": "node tools/validate-museum-data.js",
    "serve": "python3 -m http.server 8000",
    "build:meta": "node tools/generate-museums-meta.js",
    "search:demo": "node tools/search-museum-images-demo.js",
    "mcp:start": "node museum-mcp-server.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify:everyone": "bash tools/verify_everyone_with_curl.sh",
    "prepare": "git config core.hooksPath .husky || true",
    "test:sanity": "node scripts/run-sanity-agent.js default",
    "test:sanity:watch": "node scripts/run-sanity-agent.js watch",
    "test:sanity:ci": "node scripts/run-sanity-agent.js ci",
    "test:sanity:mobile": "node scripts/run-sanity-agent.js mobile",
    "test:sanity:quick": "node scripts/run-sanity-agent.js quick",
    "verify:pages": "node scripts/quick-page-check.js",
    "verify:pages:fast": "node scripts/quick-page-check-simple.js",
    "verify:pages:simple": "node scripts/quick-page-check-simple.js",
    "verify:file-placement": "bash scripts/check-file-placement.sh",
    "verify:docs-location": "bash scripts/check-docs-location.sh",
    "verify:docs-consistency": "bash scripts/check-docs-consistency.sh",
    "verify:docs-content": "node scripts/check-docs-content-consistency.js",
    "test:games": "bash scripts/test-games-quick.sh",
    "test:games:maze": "playwright test e2e/maze-game-auto.spec.ts",
    "regression:test": "node scripts/regression-gatekeeper.js",
    "regression:full": "npm test -- --coverage --verbose",
    "regression:affected": "npm test -- --findRelatedTests",
    "regression:report": "node scripts/regression-gatekeeper.js --dry-run"
  },
  "keywords": [
    "museum",
    "checklist",
    "education",
    "travel",
    "china"
  ],
  "author": "jackandking",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.58.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "qrcode": "^1.5.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/tests/**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "script.js",
      "!**/node_modules/**"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackandking/MuseumCheck.git"
  },
  "bugs": {
    "url": "https://github.com/jackandking/MuseumCheck/issues"
  },
  "homepage": "https://github.com/jackandking/MuseumCheck#readme"
}
